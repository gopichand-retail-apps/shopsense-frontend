# Documentation template only; not loaded automatically.
# Set these in Vercel Project Settings > Environment Variables before building.
# Replace the reserved .invalid host with an approved, isolated HTTPS API.
# Current local APIs must remain on loopback; they are not public deployments.
NEXT_PUBLIC_IS_MOCK=true
SHOPSENSE_MOCK_API_URL=https://shopsense-api.example.invalid
# To select an approved real API, set NEXT_PUBLIC_IS_MOCK=false and configure:
# SHOPSENSE_REAL_API_URL=https://shopsense-api.example.invalid
# VITE_* and NEXT_PUBLIC_* values are public. Never put secrets here.
